# ============================================================
# ChainVote 环境变量模板
# 用法：cp .env.example .env 后填入真实值
# 【硬约束】.env 严禁入库；本文件只允许包含占位符，不得出现任何真实密钥
# ============================================================

# ---------- RPC（部署与只读查询） ----------
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=

# ---------- 部署账户 ----------
# 【硬约束】仅本地与 CI 的 Secret 中注入；生产部署建议改用硬件钱包 + 多签
DEPLOYER_PK=

# ---------- 部署与治理时间锁（P8） ----------
# 时间锁操作的最小延时（秒）。不得低于合约下限 172800（2 天），否则部署直接 revert
TIMELOCK_MIN_DELAY=172800
# 时间锁的排程方。★非本地网络必填，且应为多签地址（如 Safe）
# 若排程权默认落到部署者 EOA，部署者将长期持有一项治理权限 —— 不满足「部署者无业务角色」
TIMELOCK_PROPOSER=
# 时间锁的执行方。留空表示任何人均可执行「已到期」的操作（推荐：消除执行方离线导致治理卡死）
TIMELOCK_EXECUTOR=
# 无延时管理员。留空表示时间锁自管理（推荐：连「修改 minDelay」都必须走时间锁）
TIMELOCK_ADMIN=
# 获得 CREATOR_ROLE（创建提案权）的地址。留空则跳过排程，仅部署 + 自检
ELECTION_ADMIN=
# 本地链专用：排程后是否快进并立即执行（默认本地 true）
FAST_FORWARD=
# 部署后是否执行冒烟测试（名册 + 提案端到端；默认本地 true）
SMOKE=

# ---------- 区块浏览器验证 ----------
BASESCAN_API_KEY=

# ---------- 测试与 CI ----------
REPORT_GAS=false

# ---------- 前端（P9 起使用；NEXT_PUBLIC_ 前缀会打进产物，禁止放密钥） ----------
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_IPFS_GATEWAY=

# ---------- 门户后端 BFF（P2 起使用） ----------
DATABASE_URL=
SESSION_SECRET=
KYC_ENDPOINT=
KYC_API_KEY=
IPFS_PINNING_TOKEN=

# ---------- Relayer（P5 起使用） ----------
RELAYER_PRIVATE_KEY=
RELAYER_FREE_QUOTA_PER_PROPOSAL=20

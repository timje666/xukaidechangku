# ============================================================
# ChainVote 环境变量模板
# 用法：cp .env.example .env 后填入真实值
# 【硬约束】.env 严禁入库；本文件只允许包含占位符，不得出现任何真实密钥
# ============================================================

# ---------- RPC（部署与只读查询） ----------
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=

# ---------- 部署账户 ----------
# 【硬约束】仅本地与 CI 的 Secret 中注入；生产部署建议改用硬件钱包 + 多签
DEPLOYER_PK=

# ---------- 区块浏览器验证 ----------
BASESCAN_API_KEY=

# ---------- 测试与 CI ----------
REPORT_GAS=false

# ---------- 前端（P9 起使用；NEXT_PUBLIC_ 前缀会打进产物，禁止放密钥） ----------
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_IPFS_GATEWAY=

# ---------- 门户后端 BFF（P2 起使用） ----------
DATABASE_URL=
SESSION_SECRET=
KYC_ENDPOINT=
KYC_API_KEY=
IPFS_PINNING_TOKEN=

# ---------- Relayer（P5 起使用） ----------
RELAYER_PRIVATE_KEY=
RELAYER_FREE_QUOTA_PER_PROPOSAL=20

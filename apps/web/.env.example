# 激活链：local（默认，hardhat node 31337）| baseSepolia
NEXT_PUBLIC_CHAIN=local

# 本地 rpc（npx hardhat node，端口 31337，chainId 31337）
NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:31337

# 生产环境（Base Sepolia）合约地址——部署后写入
NEXT_PUBLIC_PROPOSAL_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_VERIFIER_ADDRESS=

# snark 产物目录（默认 /snark，由 `npm run fetch:snark` 生成）
NEXT_PUBLIC_SNARK_ARTIFACTS_URL=

# 中继服务地址
NEXT_PUBLIC_RELAYER_URL=http://127.0.0.1:4100/relay

# 可选：WalletConnect（不设置则不把 WC 打进主包）
NEXT_PUBLIC_WC_PROJECT_ID=

# 开发/沙箱：用 Mock 证明（非 ZK）绕过不可达的 snark 产物。
# 真实 ZK 快乐路径请在可达 egress 的环境验收（设为 false 并先 fetch:snark）。
NEXT_PUBLIC_USE_MOCK_PROOF=false

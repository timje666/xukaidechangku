RELAYER_RPC=http://127.0.0.1:31337
RELAYER_CHAIN_ID=31337
RELAYER_PORT=4100

# 中继账户私钥：仅存本服务 .env，绝不进前端、绝不提交仓库。
# 占位符（非真实密钥）——部署时替换为「有 gas 的中继账户」私钥。
# 本地 hardhat node 默认账户 #0 可用，但切勿用于任何生产/公开网络。
RELAYER_PRIVATE_KEY=0xREPLACE_WITH_FUNDED_RELAYER_PRIVATE_KEY

# 可选：覆盖提案地址（否则读 deployments/hardhat.json 的 smoke.proposal）
PROPOSAL_ADDRESS=

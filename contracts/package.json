{
  "name": "@chainvote/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "ChainVote contracts workspace - 参数已冻结，见 contracts/libs/Params.sol",
  "license": "UNLICENSED",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "node": "hardhat node",
    "coverage": "cross-env COVERAGE_MODE=true hardhat coverage",
    "coverage:gaps": "node ../scripts/report-coverage-gaps.mjs",
    "format": "prettier --write \"contracts/**/*.sol\"",
    "format:check": "prettier --check \"contracts/**/*.sol\"",
    "lint:sol": "solhint \"contracts/**/*.sol\" --max-warnings 0",
    "check:links": "node ../scripts/check-link-references.mjs",
    "check:size": "node ../scripts/check-contract-size.mjs",
    "verify": "npm run format:check && npm run lint:sol && npm run build && npm run check:links && npm run check:size && npm test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "cross-env": "^10.1.0",
    "hardhat": "^2.29.1",
    "prettier": "^3.9.8",
    "prettier-plugin-solidity": "^2.4.1",
    "solhint": "^6.2.4",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "@semaphore-protocol/contracts": "^4.14.3"
  }
}
